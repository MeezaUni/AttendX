# Copy to .env and adjust. Never commit .env.

# Institutional timezone: every attendance window is evaluated in this zone on the server clock.
ATTENDX_TIMEZONE=Asia/Kolkata

# auto | cuda | cpu
ATTENDX_DEVICE=auto

# Secure (HTTPS-only) cookies. Keep true behind Tailscale Serve; set false only for plain-HTTP
# local development (http://127.0.0.1).
ATTENDX_COOKIE_SECURE=true

# Synthetic demonstration mode (banner + `attendx seed-demo`).
ATTENDX_DEMO_MODE=false

# Optional: Fernet key for face-template encryption. If unset, a key is generated once in the
# data volume (<data>/template.key). Losing it makes stored templates unusable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENDX_TEMPLATE_KEY=

# Host port (127.0.0.1 only) used by docker compose; Tailscale Serve proxies to it.
ATTENDX_PORT=8470
# Torch wheel variant baked into the image: cu128 (NVIDIA GPU) or cpu
ATTENDX_TORCH_VARIANT=cu128

# V2 defaults. The V2 Compose file uses a separate loopback port 8480 and volume.
ATTENDX_LEGACY_V1_ENABLED=false
ATTENDX_UNIVERSITY_EMAIL_DOMAIN=example.edu
ATTENDX_V2_PORTAL_URL=https://localhost:8480
# Native central development: SMTP is disabled unless explicitly configured.
# V2 Compose overrides these for its isolated Mailpit catcher (no external delivery).
ATTENDX_MAIL_TRANSPORT=disabled
ATTENDX_OFFLINE_GRANT_HOURS=24
ATTENDX_ADMIN_PHOTO_ACCESS=false
ATTENDX_PHOTO_RETENTION_DAYS=120
